# =============================================================================
# NOTIFORA — PRODUCTION
# Domain  : notifora.my.id            (landing + console + docs)
#           api.notifora.my.id        (API /v1)
#           ws.notifora.my.id         (socket-engine, WebSocket)
# Salin ke .env.production di server. Jangan commit secret.
# =============================================================================
APP_NAME=Notifora
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://notifora.my.id
API_URL=https://api.notifora.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (MySQL 8) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=notifora-mysql
DB_PORT=3306
DB_DATABASE=notifora_db
DB_USERNAME=notifora_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Redis / queue / cache / session ---------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=predis
REDIS_HOST=notifora-redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Real-time inbox --------------------------------------------------------
INAPP_PUBLISH_DRIVER=redis
SOCKET_PUBLIC_URL=wss://ws.notifora.my.id
SOCKET_JWT_SECRET=
SOCKET_ALLOWED_ORIGINS=https://notifora.my.id
INTERNAL_API_SECRET=
SSRF_RESOLVE=true

# --- Email: Brevo SMTP (isi username & SMTP key dari dashboard Brevo) ------
# Domain pengirim (notifora.my.id) harus diverifikasi di Brevo (SPF/DKIM/DMARC).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@notifora.my.id
MAIL_FROM_NAME=Notifora
MAIL_SUPPORT_ADDRESS=support@notifora.my.id

# --- Pembayaran Xendit: kunci LIVE (xnd_production_...) --------------------
# Callback: Xendit -> VexaHost (router pusat) -> https://notifora.my.id/api/payment/xendit/callback
# INTERNAL_WEBHOOK_SECRET HARUS sama dengan nilai di VexaHost dan wajib acak (jangan pakai default).
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
INTERNAL_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=3

VITE_APP_NAME="${APP_NAME}"

# Admin panel (/admin)
ADMIN_2FA_REQUIRED=true
SOCKET_HEALTH_URL=http://127.0.0.1:8042/health
