# =============================================================================
# NOTIFORA — DEVELOPMENT (lokal)
# Salin ke .env.development lalu jalankan: cp .env.development .env
# File .env.* (selain *.example) sudah di-gitignore. Jangan commit secret.
# =============================================================================
APP_NAME=Notifora
APP_ENV=development
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8040
API_URL=http://localhost:8040
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database: MySQL/MariaDB (XAMPP lokal: buat database "notifora") ---------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notifora
DB_USERNAME=root
DB_PASSWORD=

# --- Cache / queue / session (tanpa Redis) ---------------------------------
QUEUE_CONNECTION=sync
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Real-time inbox --------------------------------------------------------
INAPP_PUBLISH_DRIVER=null
SOCKET_PUBLIC_URL=ws://localhost:8042
SOCKET_JWT_SECRET=
SOCKET_ALLOWED_ORIGINS=http://localhost:8040,http://127.0.0.1:8040
INTERNAL_API_SECRET=
SSRF_RESOLVE=true

# --- Email (Brevo SMTP). Dev: log ke storage/logs, tidak benar-benar terkirim -
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@notifora.my.id
MAIL_FROM_NAME=Notifora
MAIL_SUPPORT_ADDRESS=support@notifora.my.id

# --- Pembayaran Xendit (callback diterima lewat router webhook VexaHost) ----
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
INTERNAL_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=3

VITE_APP_NAME="${APP_NAME}"

# Admin panel (/admin)
ADMIN_2FA_REQUIRED=false
SOCKET_HEALTH_URL=http://127.0.0.1:8042/health

# --- Stalwart (opsional, mail server sendiri). Pakai MAIL_MAILER=failover agar jatuh ke Brevo bila Stalwart mati ---
STALWART_SMTP_HOST=notifora-mail
STALWART_SMTP_PORT=587
STALWART_SMTP_USERNAME=
STALWART_SMTP_PASSWORD=
