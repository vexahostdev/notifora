# =============================================================================
# NOTIFORA — STAGING
# Domain  : staging.notifora.my.id   (console + landing + docs)
#           api-staging.notifora.my.id (API /v1)   ws-staging.notifora.my.id (socket)
# Salin ke .env.staging di server. Jangan commit secret.
# =============================================================================
APP_NAME="Notifora Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.notifora.my.id
API_URL=https://api-staging.notifora.my.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# --- Database (MySQL 8) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=notifora-mysql
DB_PORT=3306
DB_DATABASE=notifora_staging
DB_USERNAME=notifora_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Redis / queue / cache / session ---------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=predis
REDIS_HOST=notifora-redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Real-time inbox --------------------------------------------------------
INAPP_PUBLISH_DRIVER=redis
SOCKET_PUBLIC_URL=wss://ws-staging.notifora.my.id
SOCKET_JWT_SECRET=
SOCKET_ALLOWED_ORIGINS=https://staging.notifora.my.id
INTERNAL_API_SECRET=
SSRF_RESOLVE=true

# --- Email: Brevo SMTP (isi username & SMTP key dari dashboard Brevo) ------
# Domain pengirim (notifora.my.id) harus diverifikasi di Brevo (SPF/DKIM/DMARC).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@notifora.my.id
MAIL_FROM_NAME="Notifora Staging"
MAIL_SUPPORT_ADDRESS=support@notifora.my.id

# --- Pembayaran Xendit: pakai kunci TEST (xnd_development_...) -------------
# Callback: Xendit -> VexaHost (router pusat) -> https://staging.notifora.my.id/api/payment/xendit/callback
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
INTERNAL_WEBHOOK_SECRET=
BILLING_GRACE_DAYS=3

VITE_APP_NAME="${APP_NAME}"
